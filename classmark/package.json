{
  "name": "classmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Peer benchmark for CS and adjacent students: verify with your school email and see your percentile on each metric among students at your school, program and year.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "test:db": "bash test/run_db_tests.sh",
    "test:e2e": "bash test/e2e/run.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
