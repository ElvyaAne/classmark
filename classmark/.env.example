# From your Supabase project: Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Cloudflare Turnstile site key (the public one). Leave blank to skip the robot check.
# If you set it, also turn on CAPTCHA protection in Supabase (Authentication → Attack Protection)
# with the matching secret key.
VITE_TURNSTILE_SITE_KEY=
